# lapdog server: a self-managed LLM Observability server with ClickHouse storage.
#
#   docker build -f Dockerfile.server -t lapdog-server .
#   docker run -p 8126:8126 -v lapdog-data:/data lapdog-server
#
# Retention and disk cap: -e LAPDOG_SERVER_RETENTION=30d -e LAPDOG_SERVER_MAX_DISK=20GB
FROM python:3.13-slim

WORKDIR /src
EXPOSE 8126
VOLUME /data

ENV LAPDOG_SERVER_HOST=0.0.0.0
ENV LAPDOG_SERVER_DATA_DIR=/data
ENV LOG_LEVEL=INFO

RUN apt update && \
    apt install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

ADD README.md setup.py test_deps.txt ./
ADD ddapm_test_agent ./ddapm_test_agent
ADD lapdog ./lapdog
ADD .git ./.git
RUN pip install /src && \
    rm -rf /root/.cache/pip

# Fetch the pinned ClickHouse release for this architecture (checksum-verified) into ~/.lapdog/bin.
RUN python -c "from lapdog.self_host.clickhouse import download_binary; download_binary(progress=False)"

CMD ["lapdog", "server", "start", "--foreground"]
